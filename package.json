{
  "name": "malicious-package-scanner",
  "version": "0.1.0",
  "description": "Flags dependencies (direct or transitive, across npm/yarn/pnpm lockfiles) matching OSV.dev's known-malicious-package advisories.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "malicious-package-scanner": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "postinstall": "node scripts/postinstall.cjs",
    "prepublishOnly": "npm run build && npm test",
    "test": "npm run build && node --test test/*.test.js",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.9",
    "@types/node": "^22.19.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
